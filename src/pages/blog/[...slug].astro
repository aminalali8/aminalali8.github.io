---
import Base from "../../layouts/Base.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
---
<Base title={`${post.data.title} - Amin Al Ali Al Darwish`} description={post.data.description} path="/blog">
  <section>
    <div class="sec-head">
      <h2><a href="/blog" style="color: inherit; text-decoration: none;">&larr; Writing</a></h2>
      <span class="count">{fmt(post.data.date)}</span>
    </div>
    <h1 style="font-size: clamp(28px, 4.6vw, 42px); margin-bottom: 18px;">{post.data.title}</h1>
    {post.data.tags.length > 0 && (
      <div class="tags" style="margin-bottom: 24px;">
        {post.data.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    )}
    <div class="prose"><Content /></div>
  </section>
</Base>
