---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fmt = (d) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
---
<Base title="Blog - Amin Al Ali Al Darwish" description="Writing on platform engineering, delivery and the systems around AI tooling." path="/blog">
  <section>
    <div class="sec-head">
      <h2>Writing</h2>
      <span class="count">{posts.length} {posts.length === 1 ? "post" : "posts"}</span>
    </div>

    {posts.length === 0 ? (
      <p class="lede">No posts published yet.</p>
    ) : (
      <div class="posts">
        {posts.map((post) => (
          <article class="post-row">
            <div class="year">{fmt(post.data.date)}</div>
            <div>
              <h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
              {post.data.description && <p>{post.data.description}</p>}
              {post.data.tags.length > 0 && (
                <div class="tags">
                  {post.data.tags.map((t) => <span class="tag">{t}</span>)}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    )}
  </section>
</Base>
