---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const fmt = (d) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
---
<Base title="Blog - Amin Al Ali Al Darwish" description="Writing on platform engineering, delivery and the systems around AI tooling." path="/blog">
  <section>
    <div class="sec-head">
      <h2>Writing</h2>
      <span class="count">{posts.length === 0 ? "coming soon" : `${posts.length} ${posts.length === 1 ? "post" : "posts"}`}</span>
    </div>

    {posts.length === 0 ? (
      <div class="soon">
        <div class="eyebrow">Coming soon</div>
        <h3>The first posts are being written</h3>
        <p>
          Notes from platform engineering work: internal developer platforms,
          preview and staging environments, delivery pipelines, and what running
          serverless workloads locally actually costs you. Written up as the
          problems get solved rather than on a schedule.
        </p>
        <div class="contact">
          <a href="/rss.xml"><span class="k">rss</span> Subscribe to the feed</a>
          <a href="mailto:aminaliali8@gmail.com"><span class="k">mail</span> aminaliali8@gmail.com</a>
        </div>
      </div>
    ) : (
      <div class="posts">
        {posts.map((post) => (
          <article class="post-row">
            <div class="year">{fmt(post.data.date)}</div>
            <div>
              <h3><a href={`/blog/${post.id}`}>{post.data.title}</a></h3>
              {post.data.description && <p>{post.data.description}</p>}
              {post.data.tags.length > 0 && (
                <div class="tags">
                  {post.data.tags.map((t) => <span class="tag">{t}</span>)}
                </div>
              )}
            </div>
          </article>
        ))}
      </div>
    )}
  </section>
</Base>
