---
import "../styles/global.css";

const { title, description = "Platform engineering, internal developer platforms, cloud infrastructure, and agentic AI - coding agents, MCP servers and the guardrails they need.", path = "/" } = Astro.props;
const site = Astro.site;
const ogImage = site ? new URL("og.png", site).href : "/og.png";
// Astro.url rather than the path prop: blog posts all pass path="/blog" for nav
// highlighting, and every one of them canonicalising to /blog would be wrong.
const canonical = site ? new URL(Astro.url.pathname, site).href : Astro.url.pathname;

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Amin Al Ali Al Darwish",
  jobTitle: "Platform Engineer",
  url: site ? site.href : canonical,
  address: { "@type": "PostalAddress", addressLocality: "Vacoas", addressCountry: "MU" },
  sameAs: ["https://linkedin.com/in/aminaliali", "https://github.com/aminalali8"],
  knowsAbout: [
    "Platform engineering",
    "Internal developer platforms",
    "Agentic AI",
    "AI coding agents",
    "Model Context Protocol",
    "Kubernetes",
    "Terraform",
    "AWS",
    "CI/CD",
    "Site reliability engineering",
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="canonical" href={canonical} />
    <meta property="og:url" content={canonical} />
    <script type="application/ld+json" set:html={JSON.stringify(person)} is:inline />
    <link rel="alternate" type="application/rss+xml" title="A4D blog" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Chakra+Petch:wght@500;600;700&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=Space+Mono:wght@400;700&display=swap">
    <script is:inline>
      // Inline and blocking on purpose: a stored theme has to be on <html>
      // before the first paint, or the page flashes the other one.
      try {
        const stored = localStorage.getItem("theme");
        if (stored) document.documentElement.dataset.theme = stored;
      } catch {}
    </script>
  </head>
  <body>
    <div class="wrap">
      <nav class="nav">
        <a class="brand" href="/" aria-label="Amin Al Ali Al Darwish - home">A4D</a>
        <span class="nav-links">
          <a href="/" aria-current={path === "/" ? "page" : undefined}>Portfolio</a>
          <a href="/cv" aria-current={path === "/cv" ? "page" : undefined}>CV</a>
          <a href="/blog" aria-current={path.startsWith("/blog") ? "page" : undefined}>Blog</a>
        </span>
        <a class="nav-book" href="https://cal.com/aminad/30min" target="_blank" rel="noopener">Let's talk</a>
        <button id="theme-toggle" class="theme-switch" type="button" role="switch" aria-checked="false" hidden>
          <span class="switch-track">
            <svg class="switch-icon sun" viewBox="0 0 16 16" aria-hidden="true">
              <circle cx="8" cy="8" r="3.1" />
              <path d="M8 1.1v1.6M8 13.3v1.6M1.1 8h1.6M13.3 8h1.6M3.2 3.2l1.1 1.1M11.7 11.7l1.1 1.1M12.8 3.2l-1.1 1.1M4.3 11.7l-1.1 1.1" />
            </svg>
            <svg class="switch-icon moon" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M13.4 9.8A5.8 5.8 0 0 1 6.2 2.6 5.8 5.8 0 1 0 13.4 9.8Z" />
            </svg>
            <span class="switch-thumb"></span>
          </span>
        </button>
      </nav>
      <slot />
    </div>
    <script is:inline>
      // No stored choice means follow the system, so "current" is read from the
      // media query rather than kept in a variable of its own.
      const root = document.documentElement;
      const button = document.getElementById("theme-toggle");
      const system = window.matchMedia("(prefers-color-scheme: dark)");
      const current = () => root.dataset.theme || (system.matches ? "dark" : "light");

      const paint = () => {
        const dark = current() === "dark";
        // role="switch", so "on" is the dark theme; the thumb and both icons
        // are driven off this one attribute rather than a class of their own.
        button.setAttribute("aria-checked", String(dark));
        button.setAttribute("aria-label", `Switch to the ${dark ? "light" : "dark"} theme`);
      };

      button.addEventListener("click", () => {
        const next = current() === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        try {
          localStorage.setItem("theme", next);
        } catch {}
        paint();
      });

      system.addEventListener("change", paint);
      paint();
      // The button does nothing without this script, so it only appears with it.
      button.hidden = false;
    </script>
  </body>
</html>
